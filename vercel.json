{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/assets/(.*)",
      "dest": "/dist/client/assets/$1",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "^/(.*\\.(js|css|png|jpg|svg|ico|woff2|woff|ttf|webp|webm|mp4))",
      "dest": "/dist/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ssr"
    }
  ]
}
